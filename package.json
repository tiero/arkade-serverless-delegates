{
  "name": "arkade-serverless-delegate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serverless, multi-tenant Arkade delegate (Cloudflare Workers + R2 + Cron).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types --disable-warning=ExperimentalWarning \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
